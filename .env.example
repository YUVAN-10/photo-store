# FamilyVault Environment Configuration Template
# NOTE: Do NOT commit .env or actual production credentials to version control.

# Next.js App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Auth & PostgreSQL (Phases 2-3: Required for production, not Phase 1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-private

# Cloudflare R2 Storage (Phase 4: Direct upload & presigned URLs)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=familyvault-photos-private
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Initial Bootstrap Administrator (Phase 2)
BOOTSTRAP_ADMIN_PHONE=+15551234567
BOOTSTRAP_ADMIN_NAME="Family Admin"

# Application storage limit (hard ceiling in bytes: 10GB = 10737418240)
NEXT_PUBLIC_STORAGE_BUDGET_BYTES=10737418240
# GitHub storage (Phase 1 free forever)
GITHUB_TOKEN=your-github-pat-with-repo-scope
GITHUB_OWNER=YUVAN-10
GITHUB_REPO=photo-store
GITHUB_BRANCH=main
